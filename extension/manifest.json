{
  "manifest_version": 3,
  "name": "Colab Extras",
  "short_name": "Colab Extras",
  "version": "0.9.4",
  "description": "Google Colab file tools with Undo: inspect, ZIP, extract, recover deleted files, rename, move, copy, and revisit sidebar paths.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["downloads"],
  "background": {"service_worker": "downloads.js"},
  "content_scripts": [
    {
      "matches": ["https://colab.research.google.com/*"],
      "js": ["download-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://colab.research.google.com/*"
      ],
      "js": [
        "colab-zip.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Colab Extras",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
